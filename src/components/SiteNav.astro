---
const links = [
  { href: "#about", label: "About" },
  { href: "#experience", label: "Projects" },
  { href: "#education", label: "Education" },
  { href: "#skills", label: "Skills" },
  { href: "#interests", label: "Interests" },
  { href: "#awards", label: "Certifications" },
];
---

<nav class="site-nav" id="sideNav" aria-label="Main navigation" transition:persist>
  <div class="site-nav__inner">
    <a class="wordmark" href={`${import.meta.env.BASE_URL}`} aria-label="Shofa, home">
      shofa<span>.</span>
    </a>
    <button
      class="navbar-toggler"
      type="button"
      aria-controls="navbarSupportedContent"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <span></span><span></span>
    </button>
    <div class="nav-menu" id="navbarSupportedContent">
      <ul class="nav-links">
        {links.map(({ href, label }) => (
          <li><a href={`${import.meta.env.BASE_URL}${href}`}>{label}</a></li>
        ))}
      </ul>
      <a class="nav-availability" href="mailto:hajimakkimadanishofa@gmail.com">
        <span class="status-dot"></span> Available for opportunities
      </a>
    </div>
  </div>
</nav>
