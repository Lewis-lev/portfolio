---
import { getImage, Picture } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import CertificateCard from "../components/CertificateCard.astro";
import Icon from "../components/Icon.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SiteNav from "../components/SiteNav.astro";
import {
  certificates,
  interests,
  projects,
  skills,
  socialLinks,
  workflow,
} from "../data/portfolio";
import profile from "../assets/images/profile.webp";

const certificateCards = await Promise.all(
  certificates.map(async (certificate) => ({
    ...certificate,
    zoomSrc: (await getImage({ src: certificate.image, format: "webp" })).src,
  })),
);

const title = "Haji Makki Madani Shofa — Web Developer";
const description =
  "Portfolio of Haji Makki Madani Shofa, a web developer based in Yogyakarta, Indonesia.";
---

<BaseLayout title={title} description={description}>
  <SiteNav />
  <main id="top">
    <section class="hero section-wrap" id="about" aria-labelledby="about-title">
      <div class="hero__copy">
        <p class="eyebrow"><span class="eyebrow-mark"></span> WEB DEVELOPER <span>/</span> YOGYAKARTA, INDONESIA</p>
        <h1 id="about-title">Thoughtful digital experiences.<br /><span>From interface to backend.</span></h1>
        <p class="hero__intro">
          I’m Haji Makki Madani Shofa, a web developer who enjoys turning complex ideas into useful, clear, and
          engaging products.
        </p>
        <div class="hero__actions">
          <a class="button-primary" href="#experience">Explore selected work <Icon name="arrow-down" /></a>
          <a class="text-link" href="mailto:hajimakkimadanishofa@gmail.com">Let’s talk <Icon name="arrow-left" /></a>
        </div>
        <div class="hero__location"><Icon name="pin" /> Sleman, Yogyakarta, Indonesia</div>
      </div>

      <div class="hero__portrait">
        <div class="portrait-orbit portrait-orbit--outer"></div>
        <div class="portrait-orbit portrait-orbit--inner"></div>
        <Picture
          src={profile}
          alt="Portrait of Haji Makki Madani Shofa"
          class="portrait-image"
          widths={[320, 480, 640]}
          sizes="(min-width: 1000px) 32vw, (min-width: 600px) 48vw, 75vw"
          formats={["avif", "webp"]}
          loading="eager"
          fetchpriority="high"
          transition:name="profile-portrait"
        />
        <div class="portrait-stamp"><span>SHOFA</span><span>WEB DEV · 2024</span></div>
        <div class="portrait-note">
          <span class="status-dot"></span>
          <div><strong>Open to opportunities</strong><span>Yogyakarta, Indonesia</span></div>
        </div>
        <span class="portrait-coordinate" aria-hidden="true">07° 44' S / 110° 21' E</span>
      </div>

      <div class="hero__socials" aria-label="Social profiles">
        <span>FIND ME ELSEWHERE</span>
        {socialLinks.map(({ label, href, icon }) => (
          <a href={href} target="_blank" rel="noopener noreferrer" aria-label={`${label} profile`}>
            <Icon name={icon} />
          </a>
        ))}
        <a class="hero__email" href="mailto:hajimakkimadanishofa@gmail.com">hajimakkimadanishofa@gmail.com</a>
      </div>
    </section>

    <section class="proof-strip section-wrap" aria-label="Portfolio at a glance">
      <div><strong>{String(projects.length).padStart(2, "0")}</strong><span>selected projects</span></div>
      <div><strong>{String(skills.length).padStart(2, "0")}</strong><span>tools &amp; technologies</span></div>
      <div><strong>{String(certificates.length).padStart(2, "0")}</strong><span>certifications</span></div>
      <p>Driven by Curiosity, Defined by Creativity.</p>
    </section>

    <section class="section-wrap work-section" id="experience" aria-labelledby="projects-title">
      <header class="section-heading">
        <div>
          <p class="eyebrow">A FEW THINGS I’VE MADE</p>
          <h2 id="projects-title">Selected work<span class="heading-period">.</span></h2>
        </div>
      </header>

      <div class="project-toolbar" data-project-toolbar>
        <label class="project-search">
          <Icon name="search" />
          <input type="search" placeholder="Find a project..." aria-label="Search projects" data-project-search />
          <kbd>/</kbd>
        </label>
        <div class="project-filters" aria-label="Filter projects">
          <button type="button" class="filter-chip is-active" data-project-filter="all" aria-pressed="true">All work</button>
          {Array.from(new Set(projects.map((project) => project.category))).map((category) => (
            <button type="button" class="filter-chip" data-project-filter={category} aria-pressed="false">
              {category}
            </button>
          ))}
        </div>
        <p class="project-count" data-project-count aria-live="polite">
          Showing <strong>{projects.length}</strong> projects
        </p>
      </div>

      <div class="project-grid" data-project-grid>
        {projects.map((project, index) => <ProjectCard {...project} index={index + 1} />)}
      </div>
      <p class="project-empty" data-project-empty hidden>No projects match that search. Try another keyword.</p>
    </section>

    <section class="about-band" id="education" aria-labelledby="education-title">
      <div class="section-wrap about-band__inner">
        <div class="about-band__intro">
          <p class="eyebrow">A LITTLE ABOUT ME</p>
          <h2 id="education-title">Curiosity is part of the craft.</h2>
          <p>
            I work across frontend and backend, bringing together PHP, CodeIgniter 4, HTML, CSS, and JavaScript to
            make practical, polished websites and applications.
          </p>
          <p>
            I earned a Bachelor of Computer Science from the University of AMIKOM Yogyakarta, studying Informatics
            Management with a web development track.
          </p>
          <div class="education-note">
            <span>2020 — 2024</span><strong>University of AMIKOM Yogyakarta</strong><span>GPA 3.55</span>
          </div>
        </div>
        <div class="about-band__stack">
          <p class="eyebrow">MY TOOLKIT</p>
          <h3>Tools I reach for.</h3>
          <ul class="skill-list">
            {skills.map((skill, index) => (
              <li><span>{String(index + 1).padStart(2, "0")}</span>{skill}</li>
            ))}
          </ul>
          <div class="workflow-note">
            <Icon name="check" />
            <p><strong>How I like to work</strong>{workflow.join(" · ")}</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section-wrap interests-section" id="interests" aria-labelledby="interests-title">
      <header class="section-heading">
        <div><p class="eyebrow">OUTSIDE THE EDITOR</p><h2 id="interests-title">A curious mind<span class="heading-period">.</span></h2></div>
        <p>Good ideas come from looking beyond the screen.</p>
      </header>
      <div class="interest-grid">
        {interests.map((interest, index) => (
          <article class="interest-card">
            <span>0{index + 1}</span><p>{interest}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section-wrap certifications-section" id="awards" aria-labelledby="certifications-title">
      <header class="section-heading">
        <div><p class="eyebrow">ALWAYS LEARNING</p><h2 id="certifications-title">Certifications<span class="heading-period">.</span></h2></div>
        <p>A few milestones along the way.</p>
      </header>
      <div class="certificate-grid">
        {certificateCards.map((certificate, index) => (
          <CertificateCard {...certificate} index={index + 1} />
        ))}
      </div>
    </section>

    <footer class="contact-footer section-wrap">
      <p class="eyebrow">HAVE SOMETHING GOOD IN MIND?</p>
      <h2>Let’s make it<br /><span>work beautifully.</span></h2>
      <a class="button-primary" href="mailto:hajimakkimadanishofa@gmail.com">
        Get in touch <Icon name="arrow-left" />
      </a>
      <div class="contact-footer__bottom">
        <a class="wordmark" href="#top">shofa<span>.</span></a>
        <span>Designed with passion and love.</span>
        <a href="#top">Back to top ↑</a>
      </div>
    </footer>
  </main>

  <dialog class="image-dialog" aria-label="Certificate preview">
    <button type="button" class="image-dialog__close" aria-label="Close certificate preview">&times;</button>
    <img src="" alt="" class="image-dialog__image" />
  </dialog>
</BaseLayout>
